{
  "name": "myaberdeen-cli",
  "version": "0.3.3",
  "private": true,
  "description": "Terminal-native, read-only MyAberdeen archive client",
  "type": "module",
  "bin": {
    "myab": "./src/cli.js"
  },
  "scripts": {
    "test": "node scripts/check-runtime.mjs && node --test",
    "lint": "node scripts/check-runtime.mjs --dev && eslint .",
    "coverage": "node scripts/check-runtime.mjs && node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-include-all",
    "check": "node scripts/check.mjs && eslint . && node --test",
    "build:release": "node scripts/build-release.mjs",
    "smoke:release": "node scripts/smoke-release.mjs",
    "audit:security": "npm audit --omit=dev --audit-level=low && node scripts/audit-runtime.mjs"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "dependencies": {
    "parse5": "8.1.0",
    "playwright-core": "1.64.1"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0"
  }
}
